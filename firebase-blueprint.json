{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing basic account and preference info scoped by auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "dateOfBirth": { "type": "string", "maxLength": 10 },
        "height": { "type": "number" },
        "heightUnit": { "type": "string", "maxLength": 10 },
        "weight": { "type": "number" },
        "weightUnit": { "type": "string", "maxLength": 10 },
        "onboardingCompleted": { "type": "boolean" },
        "onboardingStep": { "type": "number" },
        "goals": { "type": "array" },
        "activityLevel": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "lastLoginAt": { "type": "string", "maxLength": 60 },
        "settings": { "type": "object" }
      },
      "required": ["uid"]
    },
    "WeightHistoryEntry": {
      "title": "WeightHistoryEntry",
      "description": "Voluntary personal weight check-in entries logged by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "weight": { "type": "number" },
        "unit": { "type": "string", "maxLength": 10 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "userId", "weight", "date", "createdAt"]
    },
    "HabitSetting": {
      "title": "HabitSetting",
      "description": "Configured habit with target, goal, category, priority, icon, schedule, and sync info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "target": { "type": "string", "maxLength": 100 },
        "goal": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "maxLength": 20 },
        "accent": { "type": "string", "maxLength": 30 },
        "icon": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "time": { "type": "string", "maxLength": 10 },
        "frequency": { "type": "string", "maxLength": 50 },
        "scheduleDays": { "type": "array" },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string", "maxLength": 60 },
        "googleCalendarEventId": { "type": "string", "maxLength": 256 },
        "googleCalendarSynced": { "type": "boolean" },
        "lastSyncedAt": { "type": "string", "maxLength": 60 },
        "reminderEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name"]
    },
    "DailyHabitLog": {
      "title": "DailyHabitLog",
      "description": "Daily habit completion tracking records per date",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "completedHabits": { "type": "object" },
        "completedCount": { "type": "number" },
        "totalActiveCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["date", "completedHabits", "completedCount", "totalActiveCount"]
    },
    "ReminderSetting": {
      "title": "ReminderSetting",
      "description": "User reminder schedules per habit",
      "type": "object",
      "properties": {
        "habitId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "reminderEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string", "maxLength": 10 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["habitId"]
    },
    "FoodLog": {
      "title": "FoodLog",
      "description": "AI-scanned or user-edited estimated food nutrition records per meal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "mealType": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "foods": { "type": "array" },
        "total": { "type": "object" },
        "source": { "type": "string", "maxLength": 50 },
        "confidence": { "type": "string", "maxLength": 20 },
        "suggestions": { "type": "array" }
      },
      "required": ["id", "userId", "date", "foods", "total"]
    },
    "HabitGoal": {
      "title": "HabitGoal",
      "description": "User personal habit targets and volume milestones",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "habitId": { "type": "string", "maxLength": 128 },
        "habitName": { "type": "string", "maxLength": 100 },
        "targetCount": { "type": "number" },
        "periodType": { "type": "string", "maxLength": 30 },
        "startDate": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "completedAt": { "type": "string", "maxLength": 60 },
        "celebrated": { "type": "boolean" }
      },
      "required": ["id", "userId", "habitId", "targetCount", "periodType", "startDate", "endDate"]
    },
    "AchievementRecord": {
      "title": "AchievementRecord",
      "description": "Persisted record of an unlocked milestone or achievement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "unlocked": { "type": "boolean" },
        "unlockedAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "unlocked", "unlockedAt"]
    },
    "CompletedRun": {
      "title": "CompletedRun",
      "description": "User completed running sessions with GPS route, duration, distance, pace, speed, and calories",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "distanceMeters": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "averagePaceSecondsPerKm": { "type": "number" },
        "averageSpeedKmh": { "type": "number" },
        "caloriesEstimate": { "type": "number" },
        "caloriesExplanation": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "routeCoordinates": { "type": "array" },
        "routePointCount": { "type": "number" },
        "startedAt": { "type": "string", "maxLength": 60 },
        "endedAt": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "maxLength": 20 }
      },
      "required": ["runId", "userId", "distanceMeters", "durationSeconds", "startedAt", "endedAt", "status"]
    },
    "SavedRoute": {
      "title": "SavedRoute",
      "description": "User favourite loop route saved for running guidance and route discovery",
      "type": "object",
      "properties": {
        "routeId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "routeName": { "type": "string", "maxLength": 150 },
        "startLocation": { "type": "object" },
        "waypoints": { "type": "array" },
        "routeCoordinates": { "type": "array" },
        "distanceMeters": { "type": "number" },
        "elevationGainMeters": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "targetDistanceKm": { "type": "number" }
      },
      "required": ["routeId", "userId", "routeName", "startLocation", "distanceMeters", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and settings documents isolating user credentials and display info"
    },
    "/users/{userId}/habitSettings/{habitId}": {
      "schema": "HabitSetting",
      "description": "User individual habit configurations"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "DailyHabitLog",
      "description": "User daily habit completion records indexed by date YYYY-MM-DD"
    },
    "/users/{userId}/reminderSettings/{habitId}": {
      "schema": "ReminderSetting",
      "description": "User habit reminder schedules"
    },
    "/users/{userId}/foodLogs/{foodLogId}": {
      "schema": "FoodLog",
      "description": "User food nutrition scan logs"
    },
    "/users/{userId}/weightHistory/{entryId}": {
      "schema": "WeightHistoryEntry",
      "description": "User voluntary weight tracking history entries"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "HabitGoal",
      "description": "User personal habit goal tracking records"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": "AchievementRecord",
      "description": "User milestone and achievement unlocked state"
    },
    "/users/{userId}/runs/{runId}": {
      "schema": "CompletedRun",
      "description": "User completed daily run records with GPS telemetry and performance metrics"
    },
    "/users/{userId}/savedRoutes/{routeId}": {
      "schema": "SavedRoute",
      "description": "User favourite and custom loop running routes"
    }
  }
}
