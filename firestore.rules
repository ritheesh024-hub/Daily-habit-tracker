rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile matching - strictly scoped by auth UID
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list: if false; // Users cannot list other users
      allow delete: if false; // Prevent accidental account deletion from client

      // Habit settings subcollection
      match /habitSettings/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // Daily habit logs subcollection
      match /dailyLogs/{date} {
        allow read, write: if isOwner(userId);
      }

      // Reminder settings subcollection
      match /reminderSettings/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Milestones subcollection
      match /milestones/{milestoneId} {
        allow read, write: if isOwner(userId);
      }

      // Food logs subcollection (AI nutrition scans & meal records)
      match /foodLogs/{foodLogId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}


